# Server Configuration
HOST=localhost
PORT=3080
DEBUG=false
LOG_LEVEL=INFO
LOG_FILE=

# Database Configuration
MONGO_URI=mongodb://localhost:27017/librechat
MONGO_MAX_POOL_SIZE=10
MONGO_MIN_POOL_SIZE=1
MONGO_MAX_IDLE_TIME_MS=60000
MONGO_WAIT_QUEUE_TIMEOUT_MS=5000
MONGO_AUTO_INDEX=true
MONGO_AUTO_CREATE=true

# Redis Configuration
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# JWT Configuration
JWT_SECRET=your-jwt-secret-change-this
JWT_ALGORITHM=HS256
JWT_REFRESH_SECRET=your-refresh-secret-change-this
JWT_EXPIRATION=900
JWT_REFRESH_EXPIRATION=604800

# Session Configuration
SESSION_EXPIRY=900000
REFRESH_TOKEN_EXPIRY=604800000

# Security
BCRYPT_ROUNDS=12
ALLOWED_DOMAINS=

# CORS Configuration
CORS_ORIGINS=http://localhost:3080,http://localhost:3000
CORS_CREDENTIALS=true

# LDAP Configuration (optional)
LDAP_URL=
LDAP_USER_SEARCH_BASE=
LDAP_BIND_DN=
LDAP_BIND_PASSWORD=

# Google OAuth (optional)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:3080/api/auth/google/callback

# GitHub OAuth (optional)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_CALLBACK_URL=http://localhost:3080/api/auth/github/callback

# Discord OAuth (optional)
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_CALLBACK_URL=http://localhost:3080/api/auth/discord/callback

# Facebook OAuth (optional)
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=
FACEBOOK_CALLBACK_URL=http://localhost:3080/api/auth/facebook/callback

# OpenID Configuration (optional)
OPENID_ISSUER=
OPENID_CLIENT_ID=
OPENID_CLIENT_SECRET=
OPENID_CALLBACK_URL=
OPENID_SCOPE=openid profile email

# SAML Configuration (optional)
SAML_ENTITY_ID=
SAML_CALLBACK_URL=
SAML_ISSUER=
SAML_CERT=

# Email Configuration
EMAIL_ENABLED=false
EMAIL_FROM=noreply@example.com
EMAIL_FROM_NAME=LibreChat
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_TLS=true

# File Storage Configuration
FILE_STORAGE_TYPE=local
FILE_UPLOAD_MAX_SIZE=20971520

# AWS S3 Configuration (if using S3)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
S3_BUCKET=

# Azure Blob Storage Configuration (if using Azure)
AZURE_STORAGE_ACCOUNT=
AZURE_STORAGE_KEY=
AZURE_CONTAINER=

# Meilisearch Configuration
MEILI_HOST=http://localhost:7700
MEILI_KEY=
ENABLE_MEILISEARCH=true

# AI API Keys
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=

# Rate Limiting
RATE_LIMIT_ENABLED=true
LOGIN_MAX_ATTEMPTS=5
LOGIN_WINDOW_MINUTES=15

# User Management
ALLOW_REGISTRATION=true
ALLOW_EMAIL_VERIFICATION=false
ALLOW_SOCIAL_LOGIN=true
ALLOW_ACCOUNT_DELETION=true

# Compression
ENABLE_COMPRESSION=true

# Trust Proxy (for reverse proxies)
TRUST_PROXY=false
